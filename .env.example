# Spring / App
SPRING_PROFILES_ACTIVE=prod
APP_BASE_URL=https://youth-welfare.kr

# DB
DB_URL=jdbc:mysql://db:3306/youth_welfare?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8&serverTimezone=Asia/Seoul
NOTIFICATION_PII_DB_URL=jdbc:mysql://db:3306/youth_welfare?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8&serverTimezone=Asia/Seoul
DB_USERNAME=app_core_rw
DB_PASSWORD=change-me
DB_MIGRATION_USERNAME=migration_admin
DB_MIGRATION_PASSWORD=change-me
DB_APP_PII_USERNAME=app_pii_rw
DB_APP_PII_PASSWORD=change-me
DB_NOTIFICATION_PII_RO_USERNAME=notification_pii_ro
DB_NOTIFICATION_PII_RO_PASSWORD=change-me

# JWT (32바이트 이상 랜덤 문자열)
JWT_SECRET=replace-with-a-long-random-secret
SECURITY_ADMIN_EMAILS=admin@example.com

# OpenAI
OPENAI_API_KEY=sk-...

# Gmail SMTP
GMAIL_USERNAME=your-account@gmail.com
GMAIL_PASSWORD=your-app-password
SMTP_SMOKE_TO=receiver@example.com

# AES-256 (32바이트 정확히)
AES_SECRET_KEY=replace-with-32-byte-secret-key

# 공공 API
YOUTH_API_KEY=replace-me
BOKJIRO_API_KEY=replace-me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
