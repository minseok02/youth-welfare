# Spring / App
SPRING_PROFILES_ACTIVE=prod
APP_BASE_URL=https://youth-welfare.kr
SECURITY_CORS_ALLOWED_ORIGINS=https://youth-welfare.kr,https://www.youth-welfare.kr,http://localhost:5173,http://127.0.0.1:5173

# DB
# 운영은 인증서 CN/SAN 과 일치하는 호스트명을 사용해야 함
DB_URL=jdbc:postgresql://db.example.internal:5432/youth_welfare?sslmode=require
APP_PII_DB_URL=jdbc:postgresql://db.example.internal:5432/youth_welfare?sslmode=require&currentSchema=youth_welfare_pii
NOTIFICATION_PII_DB_URL=jdbc:postgresql://db.example.internal:5432/youth_welfare?sslmode=require&currentSchema=youth_welfare_pii
DB_USERNAME=app_core_rw
DB_PASSWORD=change-me
DB_MIGRATION_USERNAME=migration_admin
DB_MIGRATION_PASSWORD=change-me
DB_APP_PII_USERNAME=app_pii_rw
DB_APP_PII_PASSWORD=change-me
DB_NOTIFICATION_PII_RO_USERNAME=notification_pii_ro
DB_NOTIFICATION_PII_RO_PASSWORD=change-me

# JWT (32바이트 이상 랜덤 문자열)
JWT_SECRET=replace-with-a-long-random-secret
SECURITY_ADMIN_EMAILS=admin@example.com
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60
POLICY_SEARCH_RATE_LIMIT_MAX_REQUESTS=60
POLICY_SEARCH_RATE_LIMIT_WINDOW_SECONDS=60
POLICY_DETAIL_RATE_LIMIT_MAX_REQUESTS_PER_SERVICE=20
POLICY_DETAIL_RATE_LIMIT_WINDOW_SECONDS=60
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false

# OpenAI
OPENAI_API_KEY=sk-...

# Gmail SMTP
GMAIL_USERNAME=your-account@gmail.com
GMAIL_PASSWORD=your-app-password
SMTP_SMOKE_TO=receiver@example.com
WEB_PUSH_PUBLIC_KEY=

# AES-256 (32바이트 정확히)
AES_SECRET_KEY=replace-with-32-byte-secret-key
USER_PII_SYNC_RETRY_ENABLED=true
USER_PII_SYNC_RETRY_BATCH_SIZE=100
USER_PII_SYNC_RETRY_FIXED_DELAY_MS=300000
USER_PII_SYNC_RETRY_INITIAL_DELAY_MS=60000

# 공공 API
# 복지로 중앙/지자체와 Gov24는 PUBLIC_DATA_PORTAL_API_KEY 하나를 같이 씁니다.
PUBLIC_DATA_PORTAL_API_KEY=replace-me
YOUTH_API_KEY=replace-me
COLLECT_LIST_MAX_ITEMS_PER_RUN=10000
GOV24_COLLECT_MAX_ITEMS_PER_RUN=20000
GOV24_DETAIL_MAX_CALLS_PER_RUN=50
GOV24_SUPPORT_CONDITIONS_MAX_CALLS_PER_RUN=50
COLLECT_DETAIL_CENTRAL_MAX_CALLS_PER_RUN=10000
COLLECT_DETAIL_LOCAL_MAX_CALLS_PER_RUN=10000
COLLECT_DETAIL_REQUEST_INTERVAL_MS=300
COLLECT_DETAIL_MAX_CONSECUTIVE_RATE_LIMIT_HITS=2

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
