SPRING_PROFILES_ACTIVE=prod

APP_BASE_URL=https://youthmoa.kr
SECURITY_CORS_ALLOWED_ORIGINS=https://youthmoa.kr,https://www.youthmoa.kr
AUTH_REFRESH_COOKIE_SECURE=true
# EC2-1 또는 단일 운영 노드는 true, ALB 뒤 EC2-2 standby/scale-out 노드는 false.
APP_SCHEDULER_ENABLED=true

RDS_MASTER_USERNAME=masteradmin
RDS_MASTER_PASSWORD=change-me

DB_URL=jdbc:postgresql://your-rds-endpoint.ap-northeast-2.rds.amazonaws.com:5432/youth_welfare?sslmode=require
DB_USERNAME=app_core_rw
DB_PASSWORD=change-me
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=0

APP_PII_DB_URL=jdbc:postgresql://your-rds-endpoint.ap-northeast-2.rds.amazonaws.com:5432/youth_welfare?sslmode=require&currentSchema=youth_welfare_pii
DB_APP_PII_USERNAME=app_pii_rw
DB_APP_PII_PASSWORD=change-me
DB_APP_PII_POOL_MAX_SIZE=2
DB_APP_PII_POOL_MIN_IDLE=0

NOTIFICATION_PII_DB_URL=jdbc:postgresql://your-rds-endpoint.ap-northeast-2.rds.amazonaws.com:5432/youth_welfare?sslmode=require&currentSchema=youth_welfare_pii
DB_NOTIFICATION_PII_RO_USERNAME=notification_pii_ro
DB_NOTIFICATION_PII_RO_PASSWORD=change-me
DB_NOTIFICATION_PII_RO_POOL_MAX_SIZE=1
DB_NOTIFICATION_PII_RO_POOL_MIN_IDLE=0

ADMIN_RO_DB_URL=jdbc:postgresql://your-rds-endpoint.ap-northeast-2.rds.amazonaws.com:5432/youth_welfare?sslmode=require
DB_ADMIN_RO_USERNAME=admin_dashboard_ro
DB_ADMIN_RO_PASSWORD=change-me
DB_ADMIN_RO_POOL_MAX_SIZE=1
DB_ADMIN_RO_POOL_MIN_IDLE=0

RECOMMENDATION_REVIEW_GATE_COMMAND_DB_URL=jdbc:postgresql://your-rds-endpoint.ap-northeast-2.rds.amazonaws.com:5432/youth_welfare?sslmode=require
DB_RECOMMENDATION_REVIEW_GATE_COMMAND_USERNAME=recommendation_review_gate_command_rw
DB_RECOMMENDATION_REVIEW_GATE_COMMAND_PASSWORD=change-me
RECOMMENDATION_PERSISTENCE_COMMAND_DB_URL=jdbc:postgresql://your-rds-endpoint.ap-northeast-2.rds.amazonaws.com:5432/youth_welfare?sslmode=require
DB_RECOMMENDATION_PERSISTENCE_COMMAND_USERNAME=recommendation_persistence_command_rw
DB_RECOMMENDATION_PERSISTENCE_COMMAND_PASSWORD=change-me

CHAT_SESSION_CLEANUP_DB_URL=jdbc:postgresql://your-rds-endpoint.ap-northeast-2.rds.amazonaws.com:5432/youth_welfare?sslmode=require
DB_CHAT_SESSION_CLEANUP_USERNAME=chat_session_cleanup_rw
DB_CHAT_SESSION_CLEANUP_PASSWORD=change-me

CLUSTER_AI_CLEANUP_DB_URL=jdbc:postgresql://your-rds-endpoint.ap-northeast-2.rds.amazonaws.com:5432/youth_welfare?sslmode=require
DB_CLUSTER_AI_CLEANUP_USERNAME=cluster_ai_cleanup_rw
DB_CLUSTER_AI_CLEANUP_PASSWORD=change-me

RECOMMENDATION_RETENTION_CLEANUP_DB_URL=jdbc:postgresql://your-rds-endpoint.ap-northeast-2.rds.amazonaws.com:5432/youth_welfare?sslmode=require
DB_RECOMMENDATION_RETENTION_CLEANUP_USERNAME=recommendation_retention_cleanup_rw
DB_RECOMMENDATION_RETENTION_CLEANUP_PASSWORD=change-me

COLLECT_EXECUTION_LOCK_CLEANUP_DB_URL=jdbc:postgresql://your-rds-endpoint.ap-northeast-2.rds.amazonaws.com:5432/youth_welfare?sslmode=require
DB_COLLECT_EXECUTION_LOCK_CLEANUP_USERNAME=collect_execution_lock_cleanup_rw
DB_COLLECT_EXECUTION_LOCK_CLEANUP_PASSWORD=change-me

WEB_PUSH_SUBSCRIPTION_CLEANUP_DB_URL=jdbc:postgresql://your-rds-endpoint.ap-northeast-2.rds.amazonaws.com:5432/youth_welfare?sslmode=require
DB_WEB_PUSH_SUBSCRIPTION_CLEANUP_USERNAME=web_push_subscription_cleanup_rw
DB_WEB_PUSH_SUBSCRIPTION_CLEANUP_PASSWORD=change-me

DB_MIGRATION_USERNAME=migration_admin
DB_MIGRATION_PASSWORD=change-me

JWT_SECRET=change-me-change-me-change-me-change-me
AES_SECRET_KEY=change-me-32-byte-key-material
OPENAI_API_KEY=<SECRET>

MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM_ADDRESS=your-account@gmail.com

YOUTH_API_KEY=change-me
PUBLIC_DATA_PORTAL_API_KEY=change-me
SECURITY_ADMIN_EMAILS=admin@example.com

RECOMMEND_RATE_LIMIT_PERSONAL_REFRESH_MAX_REQUESTS=50

USER_PII_SYNC_RETENTION_ENABLED=true
USER_PII_SYNC_RETENTION_SYNCED_DAYS=30

WEB_PUSH_PUBLIC_KEY=change-me
WEB_PUSH_PRIVATE_KEY=change-me
WEB_PUSH_SUBJECT=mailto:admin@example.com
WEB_PUSH_MAX_SUBSCRIPTIONS_PER_USER=10
WEB_PUSH_SEND_TIMEOUT_SECONDS=10

# 현재 runtime에서는 아래 ranking snapshot flag를 명시해 사용했다.
POLICY_RANKING_CANDIDATE_ENABLED=false
POLICY_RANKING_SNAPSHOT_READ_ENABLED=true
POLICY_RANKING_SNAPSHOT_REFRESH_ENABLED=true
POLICY_RANKING_SNAPSHOT_MAX_SIZE=20
POLICY_RANKING_SNAPSHOT_TTL_SECONDS=300
POLICY_RANKING_SNAPSHOT_REFRESH_FIXED_DELAY_MS=300000
POLICY_RANKING_SNAPSHOT_REFRESH_INITIAL_DELAY_MS=1000

# 운영/HA 시연은 ElastiCache primary endpoint를 사용한다. local redis는 rollback/단일 서버 호환 경로에만 둔다.
REDIS_HOST=your-elasticache-primary-endpoint.apn2.cache.amazonaws.com
REDIS_PORT=6379

GOV24_COLLECT_MAX_ITEMS_PER_RUN=20000
GOV24_DETAIL_MAX_CALLS_PER_RUN=50
GOV24_SUPPORT_CONDITIONS_MAX_CALLS_PER_RUN=50
COLLECT_DETAIL_CENTRAL_MAX_CALLS_PER_RUN=10000
COLLECT_DETAIL_LOCAL_MAX_CALLS_PER_RUN=10000
COLLECT_DETAIL_REQUEST_INTERVAL_MS=300
COLLECT_DETAIL_MAX_CONSECUTIVE_RATE_LIMIT_HITS=2
